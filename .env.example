# Copy to .env and fill in. Used by docker compose and by `npm run dev`.

# The address tablets browse to. Google's OAuth redirect is derived from this as
# ${PUBLIC_URL}/api/google/callback, and that exact URL must be registered as an
# authorized redirect URI in the Google Cloud console.
PUBLIC_URL=http://mac-mini.local:8080

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the parent-session cookie. Any long random string.
COOKIE_SECRET=

# Local time drives chore resets and the calendar day view.
TZ=America/Detroit
