# Copy to .env and fill in. Used by docker compose and by `npm run dev`.

# The address tablets browse to. Google's OAuth redirect is derived from this as
# ${PUBLIC_URL}/api/google/callback, and that exact URL must be registered as an
# authorized redirect URI in the Google Cloud console.
PUBLIC_URL=http://mac-mini.local:8080

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the parent-session cookie. Any long random string.
COOKIE_SECRET=

# Where deploy.sh health-checks after a swap. Defaults to this machine, which is
# right when you run the script on the mini. Set it to the mini's hostname if you
# ever drive a deploy from somewhere else.
# BASE_URL=http://mac-mini.local:8080

# Local time drives chore resets and the calendar day view.
TZ=America/Detroit

# Optional. A fine-grained GitHub token scoped to this repo with Contents:Read
# lets the dashboard notice that a newer release has been tagged. Without it the
# app still detects stale browser tabs after a deploy.
UPDATE_CHECK_TOKEN=
UPDATE_REPO=johndelong/hearth
