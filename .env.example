# Copy to .env and fill in. Used by docker compose and by `npm run dev`.

# Only used to build the Google OAuth redirect, as ${PUBLIC_URL}/api/google/callback.
# Keep it on localhost: Google requires HTTPS for redirect URIs and exempts only
# localhost, so a .local hostname is rejected. Tablets still reach the dashboard
# by hostname — that has nothing to do with this setting.
PUBLIC_URL=http://localhost:8080

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the parent-session cookie. Any long random string.
COOKIE_SECRET=

# Where update.sh health-checks after an update. Defaults to this machine, which
# is right when the script runs on the machine hosting the container. Set it to a
# hostname if you ever drive an update from somewhere else.
# BASE_URL=http://localhost:8080

# Local time drives chore resets and the calendar day view.
TZ=America/Detroit

# Not needed. The repo is public, so the release check works anonymously; a token
# here only raises GitHub's rate limit, which one call an hour never approaches.
UPDATE_CHECK_TOKEN=
UPDATE_REPO=johndelong/hearth
